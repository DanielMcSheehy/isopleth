{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "paths": {
      "isopleth": [
        "../isopleth/src/index.ts"
      ],
      "isopleth/wasm": [
        "../isopleth/src/backend/wasm.ts"
      ],
      "isopleth/editor": [
        "../isopleth/src/editor/index.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}